terminals
    lambda succ rec // terms
    Nat // types
    value nv // judgment names

/*
2. The syntax for terms, types and contexts
*/

syntax
    t ::= x                     // variable
        | lambda x : T . t[x]   // abstraction
        | t t                   // application
        | 0                     // zero
        | succ t                // successor
        | rec t { x . x' . t[x][x'] } t   // recursor   

    T ::= Nat                   // base type (not in Figure 9-1, see notes)
        | T -> T                // type of functions

    Gamma ::= *                 // empty context
            | Gamma, x : T      // term variable binding

/*
3. Judgments
*/

// Numeric values: 0 and succ of a numeric value
judgment numeric-value: nv t

---- nv-zero
nv 0

nv t
--------- nv-succ
nv (succ t)

// Predicate value: a predicate on terms
judgment value-term: value t

---------------------------- value-abs
value (lambda x : T . t[x])

nv t
---------------------------- value-nv
value t

judgment term-eq: t = t

------ eq
t = t

// Evaluation: a relation on pairs of terms
judgment step: t -> t

t1 -> t1'
----------------- E-App1
t1 t2 -> t1' t2

value t1
t2 -> t2'
----------------- E-App2
t1 t2 -> t1 t2'

value t2
---------------------------------------- E-AppAbs
(lambda x : T11 . t12[x]) t2 -> t12[t2]

t1 -> t1'
------------------ E-Succ
succ t1 -> succ t1'

t2 -> t2'
---------------------------------------------------------- E-RecA
rec t0 { x . x' . t1[x][x'] } t2 -> rec t0 { x . x' . t1[x][x'] } t2'

---------------------------------------------- E-RecZ
rec t0 { x . x' . t1[x][x'] } 0 -> t0

nv t
t2 = rec t0 { x . x' . t1[x][x'] } t
--------------------------------------------------------- E-RecS
rec t0 { x . x' . t1[x][x'] } (succ t) -> t1[t][t2]

// A

/*
    double = λn: Nat.rec(0;x.y.succ(succ y))(n)
    double 2 = λn: Nat.rec(0;x.y.succ(succ y))(n) 2

    Step 1 - beta reduction 
    2 é um nv -> aplicar E-AppAbs:
        λn: Nat. rec(0;x.y.succ(succ y))(n) 2 -> rec(0;x.y.succ(succ y))(2)

    Step 2 - first unfolding of the recursor
    Achar uma regra que se aplique. 2 é succ 1, por isso podemos aplicar a regra E-RecS:
        rec(0;x.y.succ(succ y))(succ 1) -> succ (succ (rec (0;x.y.succ(succ y))(1)))

    Step 3 - second unfolding, reached via congruence
    Usando a mesma lógica do Step 2, mas agora 1 = succ 0.
    Aplica-se, ainda, E-Succ duas vezes para os dois succ do lado esquerdo.
        succ (succ (rec (0;x.y.succ(succ y))(1))) -> succ (succ (succ (succ (rec (0;x.y.succ(succ y))(0)))))

    Step 4 - base case, reached via congruence
    Agora podemos aplicar a regra E-RecZ para chegar ao resultado pretendido.
    Aplicamos 4 E-Succ nos 4 suc da esquerda.
    1ª:
        succ (succ (succ (succ (rec (0;x.y.succ(succ y))(0))))) -> succ (succ (succ (succ 0))) = 4, logo
            double 2     ->* 4 
*/

judgment multistep: t ->* t

--------------- Ms-Refl
t ->* t

t -> t'
t' ->* t''
--------------- Ms-Trans
t ->* t''   

// n = x1
lemma double-2-is-4:
    exists (lambda x1 : Nat . (rec 0 { x . x' . succ (succ x') } x1)) (succ (succ 0)) ->* succ (succ (succ (succ 0)))
    // Confirmar que 2 +e value para usar a regra AppAbs
    d1: nv 0 by rule nv-zero
    d2: nv (succ 0) by rule nv-succ on d1
    d3: nv (succ (succ 0)) by rule nv-succ on d2
    d4: value (succ (succ 0)) by rule value-nv on d3 // 2 é value
    d5: (lambda x1 : Nat . (rec 0 { x . x' . succ (succ x') } x1)) (succ (succ 0))
         -> rec 0 { x . x' . succ (succ x') } (succ (succ 0)) by rule E-AppAbs on d4 // step 1
    // d6 nomeia explicitamente a chamada recursiva rec(...)(1), 
    // pois SASyLF não aceita substituições diretas como t1[t][rec ...]
    d6: rec 0 { x . x' . succ (succ x') } (succ 0)
         = rec 0 { x . x' . succ (succ x') } (succ 0)
         by rule eq
    d7: rec 0 { x . x' . succ (succ x') } (succ (succ 0))
         -> succ (succ (rec 0 { x . x' . succ (succ x') } (succ 0)))
         by rule E-RecS on d2, d6 
    // Step 3
    d8: rec 0 { x . x' . succ (succ x') } 0
         = rec 0 { x . x' . succ (succ x') } 0
         by rule eq
    d9: rec 0 { x . x' . succ (succ x') } (succ 0)
         -> succ (succ (rec 0 { x . x' . succ (succ x') } 0))
         by rule E-RecS on d1, d8
    d10: succ (rec 0 { x . x' . succ (succ x') } (succ 0))
         -> succ (succ (succ (rec 0 { x . x' . succ (succ x') } 0)))
         by rule E-Succ on d9
    d11: succ (succ (rec 0 { x . x' . succ (succ x') } (succ 0)))
         -> succ (succ (succ (succ (rec 0 { x . x' . succ (succ x') } 0))))
         by rule E-Succ on d10 // Fim do step 3
    d12: rec 0 { x . x' . succ (succ x') } 0 -> 0 by rule E-RecZ // Início step 4
    d13: succ (rec 0 { x . x' . succ (succ x') } 0) -> succ 0 by rule E-Succ on d12
    d14: succ (succ (rec 0 { x . x' . succ (succ x') } 0)) -> succ (succ 0) by rule E-Succ on d13
    d15: succ (succ (succ (rec 0 { x . x' . succ (succ x') } 0))) -> succ (succ (succ 0)) by rule E-Succ on d14
    d16: succ (succ (succ (succ (rec 0 { x . x' . succ (succ x') } 0)))) -> succ (succ (succ (succ 0))) by rule E-Succ on d15 //Fim step 4
    // Garantir que a expressão evoluiu para 4 em ->*
    d17: succ (succ (succ (succ 0))) ->* succ (succ (succ (succ 0))) by rule Ms-Refl
    d18: succ (succ (succ (succ (rec 0 { x . x' . succ (succ x') } 0)))) ->* succ (succ (succ (succ 0))) by rule Ms-Trans on d16, d17
    d19: succ (succ (rec 0 { x . x' . succ (succ x') } (succ 0))) ->* succ (succ (succ (succ 0))) by rule Ms-Trans on d11, d18
    d20: rec 0 { x . x' . succ (succ x') } (succ (succ 0)) ->* succ (succ (succ (succ 0))) by rule Ms-Trans on d7, d19
    proof by rule Ms-Trans on d5, d20
end lemma

// B

// sum n m = n + m 
// sum = λn:Nat.λm:Nat. rec(m; x.y.succ y)(n)
// sum = lambda x1 : Nat . (lambda x2 : Nat . (rec x2 {x . x'. succ x'} x1 )) SASyLF definition

lemma sum-2-4-is-6: 
    exists ((lambda x1 : Nat . (lambda x2 : Nat . (rec x2 { x . x' . succ x' } x1))) 
        (succ (succ 0))) (succ (succ (succ (succ 0)))) ->* succ (succ (succ (succ (succ (succ 0)))))
    d1: nv 0 by rule nv-zero
    d2: nv (succ 0) by rule nv-succ on d1
    d3: nv (succ (succ 0)) by rule nv-succ on d2
    d4: nv (succ (succ (succ 0))) by rule nv-succ on d3
    d5: nv (succ (succ (succ (succ 0)))) by rule nv-succ on d4
    d6: value (succ (succ 0)) by rule value-nv on d3                // provar que 2 é um value
    d7: value (succ (succ (succ (succ 0)))) by rule value-nv on d5  // provar que 4 é um value
    d8: ((lambda x1 : Nat . (lambda x2 : Nat . (rec x2 { x . x' . succ x' } x1))) (succ (succ 0)))
        -> (lambda x2 : Nat . (rec x2 { x . x' . succ x' } (succ (succ 0)))) // como t2 é 2 4, primeira prova-se para 2
        by rule E-AppAbs on d6
    d9: (((lambda x1 : Nat . (lambda x2 : Nat . (rec x2 { x . x' . succ x' } x1))) (succ (succ 0)))
        (succ (succ (succ (succ 0)))))
        -> (lambda x2 : Nat . (rec x2 { x . x' . succ x' } (succ (succ 0))))
            (succ (succ (succ (succ 0))))
        by rule E-App1 on d8
    d10: (lambda x2 : Nat . (rec x2 { x . x' . succ x' } (succ (succ 0)))) (succ (succ (succ (succ 0))))
        -> rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ (succ 0)) // aplica-se a regra para 2 4 como t2
        by rule E-AppAbs on d7
    // x2 = 4
    d11: rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ 0)
        = rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ 0)
        by rule eq
    // reduz 2 para 1
    d12: rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ (succ 0))
        -> succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ 0))
        by rule E-RecS on d2, d11
    // reduzindo 1 para 0
    d13: rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0
        = rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0
        by rule eq
    // reduz 1 para 0
    d14: rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ 0)
        -> succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0)
        by rule E-RecS on d1, d13
    d15: succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ 0))
        -> succ (succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0))
        by rule E-Succ on d14
    // aplica-se E-RecZ
    d16: rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0
        -> succ (succ (succ (succ 0))) by rule E-RecZ
    d17: succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0)
        -> succ (succ (succ (succ (succ 0)))) by rule E-Succ on d16
    d18: succ (succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0))
        -> succ (succ (succ (succ (succ (succ 0))))) by rule E-Succ on d17
        
    d19: succ (succ (succ (succ (succ (succ 0))))) ->* succ (succ (succ (succ (succ (succ 0))))) by rule Ms-Refl
    d20: succ (succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } 0)) ->* succ (succ (succ (succ (succ (succ 0))))) by rule Ms-Trans on d18, d19 
    d21: succ (rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ 0)) ->* succ (succ (succ (succ (succ (succ 0))))) by rule Ms-Trans on d15, d20 
    d22: rec (succ (succ (succ (succ 0)))) { x . x' . succ x' } (succ (succ 0)) ->* succ (succ (succ (succ (succ (succ 0))))) by rule Ms-Trans on d12, d21 
    d23: (lambda x2 : Nat . (rec x2 { x . x' . succ x' } (succ (succ 0)))) (succ (succ (succ (succ 0)))) ->* succ (succ (succ (succ (succ (succ 0))))) by rule Ms-Trans on d10, d22
    proof by rule Ms-Trans on d9, d23
end lemma

judgment typing: Gamma |- t : T
assumes Gamma

/*
The form of T-Var is imposed by SASyLF: the variable is the last one in
the context. Variables further to the left are reached by weakening and
exchange.
*/
----------------------- T-Var
Gamma, x : T |- x : T

Gamma, x : T1 |- t2[x] : T2
------------------------------------------- T-Abs
Gamma |- lambda x : T1 . t2[x] : T1 -> T2

Gamma |- t1 : T11 -> T12
Gamma |- t2 : T11
-------------------------- T-App
Gamma |- t1 t2 : T12

------------------- T-Zero
Gamma |- 0 : Nat

Gamma |- t1 : Nat
------------------------ T-Succ
Gamma |- succ t1 : Nat

// C 
// Typing rule for the recursor
Gamma |- t0 : T
Gamma, x : Nat, x' : T |- t1[x][x'] : T
Gamma |- t2 : Nat
----------------------------------------------------- T-Rec
Gamma |- rec t0 { x . x' . t1[x][x'] } t2 : T

// D

// double
/*
    double = λx1: Nat.rec(0;x.x'.succ(succ x'))(x1) 
    
    Gamma, x1: Nat |- rec(0;x.x'.succ(succ x'))(x1): T2
 --------------------------------------------------------------- T-Abs   
    Gamma |- λx1: Nat.rec(0;x.x'.succ(succ x'))(x1): Nat -> T2 

    Com Gamma = (x1: Nat) -> x1: Nat |- rec(0;x.x'.succ(succ x'))(x1): T2

                            --------------------------------- T-Var
                            x1:Nat, x:Nat, x': Nat |- x': Nat
                            -------------------------------------- T-Succ
T2 = Nat                    x1:Nat, x:Nat, x': Nat |- succ x': Nat
----------------- T-Zero   ---------------------------------------------- T-Succ    ----------------------T-Var  
x1: Nat |- 0: Nat           x1:Nat, x:Nat, x': Nat |- succ(succ x'): Nat               x1: Nat |- x1: Nat
------------------------------------------------------------------------------------------------------------ T-Rec
                            x1: Nat |- rec(0;x.x'.succ(succ x'))(x1): -T2- Nat // T2 foi substituído

    Provado que T2 = Nat

    (aplicar a árvore derivada anteriormente)
  ---------------------------------------------------T-Rec
    *, x1: Nat |-  rec(0;x.x'.succ(succ x'))(x1): Nat
-------------------------------------------------------------- T-Abs
     |- λx1: Nat.rec(0;x.x'.succ(succ x'))(x1)  : Nat -> Nat
*/

lemma double-is-typable:
    exists * |- (lambda x1 : Nat . (rec 0 { x . x' . succ (succ x') } x1)) : Nat -> Nat
    d1: *, x1: Nat |- 0: Nat by rule T-Zero
    d2: *, x1: Nat, x: Nat, x': Nat |- x': Nat by rule T-Var
    d3: *, x1: Nat, x: Nat, x': Nat |- succ x': Nat by rule T-Succ on d2
    d4: *, x1: Nat, x: Nat, x': Nat |- succ(succ x'): Nat by rule T-Succ on d3
    d5: *, x1: Nat |- x1: Nat by rule T-Var
    d6: *, x1: Nat |- (rec 0 {x . x' . succ (succ x')} x1): Nat by rule T-Rec on d1, d4, d5
    proof by rule T-Abs on d6
end lemma

// sum
/*
    sum = λx1:Nat.λx2:Nat.rec(x2;x.x'.succ x')(x1)

    Gamma, x1: Nat |- λx2: Nat . rec(x2; x.x'.succ x')(x1): T2
 ------------------------------------------------------------------------ T-Abs   
    Gamma |- λx1: Nat . λx2: Nat . rec(x2; x.x'.succ x')(x1): Nat -> T2 

    T2 = Nat -> T3

    Gamma, x1: Nat, x2: Nat |- rec(x2; x.x'.succ x')(x1): T3
------------------------------------------------------------------------ T-Abs  
    Gamma, x1: Nat |- λx2: Nat . rec(x2; x.x'.succ x')(x1): Nat -> T3

    Com Gamma = (x1: Nat, x2: Nat) -> x1: Nat, x2: Nat |- rec(x2;x.x'.succ x')(x1): T3


                                       ------------------------------------------- T-Var
Prova que T3 = Nat                      x1:Nat, x2:Nat, x:Nat, x': Nat |- x': Nat
---------------------------- T-Var   ------------------------------------------------ T-Succ     ------------------------------ T-Var (primeiro weakning)
x1: Nat, x2: Nat |- x2: Nat           x1:Nat, x2:Nat, x:Nat, x': Nat |- succ x': Nat               x1: Nat, x2: Nat |- x1: Nat
-------------------------------------------------------------------------------------------------------------------------------------- T-Rec
                                    x1: Nat, x2: Nat |- rec(x2;x.x'.succ x')(x1): -T3- Nat // T3 foi substituído

        Provado que T2 = Nat -> T3 = Nat -> Nat

(aplicar a árvore derivada anteriormente)
----------------------------------------------------T-Rec
*, x1:Nat, x2:Nat |- rec(x2;x.x'.succ x')(x1) : Nat
------------------------------------------------------------------- T-Abs
*, x1:Nat |- (lambda x2:Nat. rec(x2;x.x'.succ x')(x1)) : Nat -> Nat
-------------------------------------------------------------------------------------- T-Abs
            * |- λx1:Nat.λx2:Nat.rec(x2;x.x'.succ x')(x1) : Nat -> Nat -> Nat
*/

lemma sum-is-typable: 
    exists * |- (lambda x1 : Nat . lambda x2 : Nat . (rec x2 { x . x' . succ x' } x1)) : Nat -> (Nat -> Nat)
    d1: *, x1: Nat, x2: Nat |- x2: Nat by rule T-Var
    d2: *, x1: Nat, x2: Nat, x: Nat, x': Nat |- x': Nat by rule T-Var
    d3: *, x1: Nat, x2: Nat, x: Nat, x': Nat |- succ x': Nat by rule T-Succ on d2
    d4: *, x1: Nat |- x1: Nat by rule T-Var
    d5: *, x1: Nat, x2: Nat |- x1: Nat by weakening on d4 //necessário isto porque entra em conflito com o d1
    d6: *, x1: Nat, x2: Nat |- (rec x2 {x . x' . succ x'} x1): Nat by rule T-Rec on d1, d3, d5
    d7: *, x1: Nat |- lambda x2: Nat. (rec x2 {x . x' . succ x'} x1): Nat -> Nat by rule T-Abs on d6
    proof by rule T-Abs on d7
end lemma

// E

// pred = λx1:Nat. rec(0;x.x'.x)(x1)

/*
    pred = λx1:Nat. rec(0;x.x'.x)(x1)

    Gamma, x1: Nat |- rec(0; x.x'.x)(x1): T2
 ------------------------------------------------------------------------ T-Abs   
    Gamma |- λx1: Nat . rec(0; x.x'. x)(x1): Nat -> T2 

    T2 = Nat 

    Com Gamma = (x1: Nat) -> x1: Nat |- rec(0;x.x'. x)(x1): T2


                                    
Prova que T2 = Nat                      
-------------------- T-Zero      ---------------------------------------- T-Var       --------------------- T-Var 
x1: Nat |- 0: Nat                   x1:Nat,  x:Nat, x': Nat |- x: Nat                   x1: Nat |- x1: Nat
-------------------------------------------------------------------------------------------------------------------------------------- T-Rec
                                    x1: Nat |- rec(0;x.x'. x)(x1): -T2- Nat // T2 foi substituído

        Provado que T2 = Nat

(aplicar a árvore derivada anteriormente)
-----------------------------------------T-Rec
*, x1:Nat |- rec(0;x.x'. x)(x1) : Nat
----------------------------------------------- T-Abs
    * |- λx1:Nat. rec(0;x.x'.x)(x1) : Nat -> Nat
*/

lemma pred-is-typable:
    exists * |- (lambda x1 : Nat . (rec 0 { x . x' . x } x1)) : Nat -> Nat
    d1: *, x1: Nat |- 0: Nat by rule T-Zero
    d2: *, x1: Nat, x: Nat |- x: Nat by rule T-Var
    d3: *, x1: Nat, x: Nat, x': Nat |- x: Nat by weakening on d2
    d4: *, x1: Nat |- x1: Nat by rule T-Var
    d5: *, x1: Nat |- (rec 0 {x . x' . x} x1): Nat by rule T-Rec on d1, d3, d4
    proof by rule T-Abs on d5
end lemma

lemma pred-zero-is-nv:
    exists ((lambda x1 : Nat . (rec 0 { x . x' . x } x1)) 0) ->* 0
    d0: nv 0 by rule nv-zero
    d1: value 0 by rule value-nv on d0
    d2: ((lambda x1: Nat . (rec 0 {x. x'.x} x1)) 0) -> (rec 0 {x.x'.x} 0) by rule E-AppAbs on d1
    d3: (rec 0 {x. x'. x} 0) -> 0 by rule E-RecZ
    d4: 0 ->* 0 by rule Ms-Refl
    d5: (rec 0 { x . x' . x } 0) ->* 0 by rule Ms-Trans on d3, d4
    proof by rule Ms-Trans on d2, d5
end lemma

lemma pred-succ-is-nv:
    forall p: nv t
    exists ((lambda x1 : Nat . (rec 0 { x . x' . x } x1)) (succ t)) ->* t
    proof by induction on p:
        case rule
            -------- nv-zero
            _: nv 0
        is
            d1: value 0 by rule value-nv on p
            d2: nv succ 0 by rule nv-succ on p
            d3: value succ 0 by rule value-nv on d2 
            d4: ((lambda x1 : Nat . (rec 0 { x . x' . x } x1)) (succ 0)) -> (rec 0 { x . x' . x } (succ 0)) by rule E-AppAbs on d3
            d5: (rec 0 { x . x' . x } 0) = (rec 0 { x . x' . x } 0) by rule eq
            d6: (rec 0 { x . x' . x } (succ 0)) -> 0 by rule E-RecS on p, d5
            d7: 0 ->* 0 by rule Ms-Refl
            d8: (rec 0 { x . x' . x } (succ 0)) ->* 0 by rule Ms-Trans on d6, d7
            proof by rule Ms-Trans on d4, d8
        end case
        case rule
            d1: nv t1
            --------- nv-succ
            _: nv (succ t1) 
        is
            d2: nv (succ t1) by rule nv-succ on d1
            d3: nv (succ (succ t1)) by rule nv-succ on d2
            d4: value (succ (succ t1)) by rule value-nv on d3
            d5: ((lambda x1 : Nat . (rec 0 { x . x' . x } x1)) (succ (succ t1)))
                 -> (rec 0 { x . x' . x } (succ (succ t1))) by rule E-AppAbs on d4
            d6:  (rec 0 { x . x' . x } succ t1) = (rec 0 { x . x' . x } succ t1) by rule eq
            d7: (rec 0 { x . x' . x } (succ (succ t1))) -> succ t1 by rule E-RecS on d2, d6
            d8: succ t1 ->* succ t1 by rule Ms-Refl
            d9: (rec 0 { x . x' . x } (succ (succ t1))) ->* succ t1 by rule Ms-Trans on d7, d8
            proof by rule Ms-Trans on d5, d9
        end case
    end induction
end lemma

/*
    pred n vs double n
    pred n completa em 2 steps, independente do valor de n, enquanto double n completa em um número de steps proporcional a n.
    Sendo pred = λn. rec(0; x.x'. x)(n), x' nunca aparece no corpo do recursor, ou seja, quando E-RecS é aplicado, o resultado é o predecessor
    diretamente, pelo que não precisa de fazer unfold de novo para resolver x', porque x' nunca aparece no corpo do recursor.
    Já no double = λn. rec(0; x.x'. succ(succ x'))(n), x' aparece no corpo do recursor, pelo que para saber o que é x', é preciso reduzir 
    continuamente. Cada camada de succ implica em mais um passo de redução, juntando uma chamada a E-RecS, ou E-RecZ na base, 
    conclui-se que o número de passos é proporcional a n.
*/

// F

/*
    ack m = λm:Nat.rec(t0; x.x'.t1)(m)
    Base case: m = 0
    ack 0 n = succ n isto é o mesmo que -> λn:Nat.succ n
    t0 = λn:Nat.succ n

    Step case: m = succ m' (recursivo) -> λn:Nat.rec(t2;y.y.t3)
    ack (succ m') 0 = ack m' 1 = x' 1
    ack (succ m') succ n = ack m' (ack (succ m') n) = x' (ack (succ m') n)
    t2= x' 1
    t3 = x' y' // y' pra o ack (succ m') succ n representa o (ack (succ m') n)
    λn:Nat.rec(x' 1; y.y', x'y')(n)

    Formando o termo: 
    ack = λm:Nat.rec(λn:Nat.succ n; x.x'. (λn:Nat.rec(x' 1; y.y', x'y')(n)))(m)


Começo: 
    m:Nat |. rec(t0,x.x'.t1)(m): T2
------------------------------------------- T-Abs
* |- λm:Nat.rec(t0,x.x'.t1)(m): Nat -> T2


                                                                        (*1 árvore da 2 parte do T-Rec)
                                                                        Gamma = m:Nat, x:Nat, x':(Nat -> Nat)

                                        (1 = succ 0)                   
                                        ----------------------T-Zero     
                                        Gamma, n:Nat |- 0: Nat
-------------------------------- T-Var ------------------------ T-Succ    ---------------------------------------- T-Var        ------------------------------------ T-Var
Gamma, n:Nat |-  x': Nat -> Nat         Gamma, n:Nat |- 1: Nat             Gamma, n:Nat, y:Nat, y': Nat |- x': Nat -> Nat          Gamma, n:Nat, y:Nat, y': Nat |- y': Nat
-------------------------------------------------------------- T-App    -------------------------------------------------------------------------------------- T-App    --------------------------- T-Var
                        Gamma, n:Nat |- x' 1 : Nat                                          Gamma, n: Nat, y:Nat, y': Nat |- x'y': Nat                                              Gamma, n: Nat |- n:Nat
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- T-Rec
                                                            Gamma, n: Nat |- rec(x' 1; y.y', x'y')(n) : Nat -> Nat
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- T-Abs
                                                            Gamma |- λn:Nat.rec(x' 1; y.y', x'y')(n) : Nat -> Nat
    (T2 = Nat)
    ----------------------- T-Var
    m:Nat, n: Nat |- n: Nat                                                          
    --------------------------- T-Succ            
    m:Nat, n:Nat |- succ n: Nat                                        (árvore construída antes (*1))
    ---------------------------------- T-Abs    -------------------------------------------------------------------------------- T-Abs  ------------------- T-Var
    m:Nat |- λn:Nat.succ n: Nat -> Nat              m:Nat, x:Nat, x':(Nat->Nat) |- λn:Nat.rec(x' 1; y.y', x'y')(n) : Nat -> Nat           m:Nat |- m: Nat 
   ---------------------------------------------------------------------------------------------------------------------------------------------------------------- T-Rec
                                    m:Nat |- rec(λn:Nat.succ n; x.x'. (λn:Nat.rec(x' 1; y.y', x'y')(n)))(m): Nat -> Nat
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------- T-Abs
                                   * |- λm:Nat.rec(λn:Nat.succ n; x.x'. (λn:Nat.rec(x' 1; y.y', x'y')(n)))(m): Nat -> (Nat -> Nat)
*/

// m = x1
// n = x2
// y = x3
lemma ack-is-typable:
    exists * |- (lambda x1 : Nat . (rec (lambda x2 : Nat . (succ x2)) { x . x' . (lambda x2 : Nat . (rec (x' (succ 0)) { x3 . x3' . (x' x3') } x2)) } x1)) : Nat -> (Nat -> Nat)
    d1: *, x1:Nat, x2:Nat |- x2:Nat by rule T-Var
    d2: *, x1:Nat, x2:Nat |- succ x2:Nat by rule T-Succ on d1
    d3: *, x1:Nat |- (lambda x2:Nat.(succ x2)): Nat -> Nat by rule T-Abs on d2
    d4: *, x1:Nat, x:Nat, x':(Nat->Nat) |- x': Nat -> Nat by rule T-Var
    d5: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat |- x': Nat -> Nat by weakening on d4
    d6: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat |- 0: Nat by rule T-Zero
    d7: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat |- succ 0: Nat by rule T-Succ on d6
    d8: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat |- x' succ 0: Nat by rule T-App on d5, d7
    d9: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat, x3:Nat, x3':Nat |- x': Nat -> Nat by weakening on d4
    d10: *, x1:Nat, x:Nat, x':(Nat->Nat), x2: Nat, x3:Nat, x3':Nat |- x3': Nat by rule T-Var
    d11: *, x1:Nat, x:Nat, x':(Nat->Nat), x2: Nat, x3:Nat, x3':Nat |- (x' x3'): Nat by rule T-App on d9, d10
    d12: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat |- x2: Nat by rule T-Var
    d13: *, x1:Nat, x:Nat, x':(Nat->Nat), x2:Nat |- (rec (x' (succ 0)) { x3 . x3' . (x' x3') } x2): Nat by rule T-Rec on d8, d11, d12
    d14: *, x1:Nat, x:Nat, x':(Nat->Nat) |- (lambda x2 : Nat . (rec (x' (succ 0)) { x3 . x3' . (x' x3') } x2)): Nat -> Nat by rule T-Abs on d13
    d15: *, x1:Nat |- x1: Nat by rule T-Var
    d16: *, x1: Nat |- (rec (lambda x2 : Nat . (succ x2)) { x . x' . (lambda x2 : Nat . (rec (x' (succ 0)) { x3 . x3' . (x' x3') } x2)) } x1): Nat -> Nat by rule T-Rec on d3, d14, d15
    proof by rule T-Abs on d16 
end lemma

// outer recursor type: Nat -> Nat (d3)
/*
    Why is this not possible with first-order primitive recursion (recursors that only return numbers)?
    First-order primitive recursion não conseguem fazer isto porque exigem que t0 e t1 sejam Nat para que no final o recursor retorne numbers.
    No Sistema de Godel T, conseguimos definir funções Ackermann precisamente, porque o seu recursor permite que o retorno do tipo T seja um tipo arbitrário, deixando o 
    recursor de fora encaminhar e aplicar um função toda num único passo. Isto é impossível se o tipo do retorno for exclusivamente Nat, como é o cado das first-order recursion. 
*/

// G

lemma canonical-forms-nat:
    forall p1: value t
    forall p2: * |- t: Nat
    exists nv t
    proof by induction on p1:
        case rule 
            d1: nv t
            ------------ value-nv
            _: value t
        is
            proof by case analysis on d1:
                case rule
                    -------- nv-zero
                    _: nv 0
                is
                    proof by rule nv-zero
                end case
                case rule 
                    d2: nv t1
                    --------- nv-succ
                    _: nv (succ t1)
                is
                    proof by rule nv-succ on d2
                end case 
            end case analysis
        end case
        case rule
            ---------------------------- value-abs
            _: value (lambda x : T . t1[x])
        is 
            proof by contradiction on p2
        end case
    end induction
end lemma

theorem progress:
    forall p: * |- t : T
    exists value t or t -> t'
    proof by induction on p:
    // Case Zero
        case rule
        ------------------- T-Zero
        _: * |- 0 : Nat
        is
            d1: nv 0 by rule nv-zero
            _: value t by rule value-nv on d1
        end case
    // Case Succ
        case rule
        d1: * |- t1 : Nat
        ------------------------ T-Succ
        _: * |- succ t1 : Nat
        is 
            ih: value t1 or t1 -> t1' by induction hypothesis on d1
            proof by case analysis on ih:
                case or ih1: value t1 is 
                    d2: nv t1 by lemma canonical-forms-nat on ih1, d1
                    d3: nv t by rule nv-succ on d2
                    _: value t by rule value-nv on d3
                end case
                case or ih2: t1 -> t1' is
                    _: t -> succ t1' by rule E-Succ on ih2
                end case
            end case analysis 
        end case
    // Case Abs
        case rule
            _: *, x : T1 |- t2[x] : T2
            ------------------------------------------- T-Abs
            _: * |- lambda x : T1 . t2[x] : T1 -> T2
        is
            _: value (lambda x : T1 . t2[x]) by rule value-abs
        end case
    // Case App
        case rule
            d1: * |- t1 : T11 -> T12
            d2: * |- t2 : T11
            -------------------------- T-App
            _: * |- t1 t2 : T12
        is
            ih1: value t1 or t1 -> t1' by induction hypothesis on d1
            proof by case analysis on ih1:
                case or v1: value t1 is
                    ih2: value t2 or t2 -> t2' by induction hypothesis on d2
                    proof by case analysis on ih2:
                        case or v2: value t2 is
                            proof by case analysis on v1:
                                case rule 
                                    ---------------------------- value-abs
                                    _: value (lambda x : T1 . t11[x]) 
                                is
                                    _: (lambda x : T1 . t11[x]) t2 -> t11 [t2]  by rule E-AppAbs on v2
                                end case 
                                case rule
                                    d5: nv t5
                                    ---------------------------- value-nv
                                    _: value t5
                                is
                                    proof by case analysis on d5:
                                        case rule 
                                            ---- nv-zero
                                            _: nv 0
                                        is
                                            proof by contradiction on d1
                                        end case
                                        case rule
                                            d6: nv t11
                                            --------- nv-succ
                                            _: nv (succ t11)
                                        is
                                            proof by contradiction on d1
                                        end case
                                    end case analysis
                                end case
                            end case analysis
                        end case
                        case or e2: t2 -> t2' is
                            _: t1 t2 -> t1 t2' by rule E-App2 on v1, e2
                        end case
                    end case analysis
                end case
                case or e1: t1 -> t1' is
                    _: t1 t2 -> t1' t2 by rule E-App1 on e1
                end case
            end case analysis
        end case
        case rule
            d1: * |- t0 : T
            d2: *, x : Nat, x' : T |- t1[x][x'] : T
            d3: * |- t2 : Nat
            ----------------------------------------------------- T-Rec
            _: * |- rec t0 { x . x' . t1[x][x'] } t2 : T
        is
            ih2: value t2 or t2 -> t2' by induction hypothesis on d3
            proof by case analysis on ih2:
                case or v2: value t2 is
                d4: nv t2 by lemma canonical-forms-nat on v2, d3
                    proof by case analysis on d4:
                        case rule
                            -------- nv-zero
                            _: nv 0
                        is
                            _: rec t0 { x . x' . t1[x][x'] } 0 -> t0 by rule E-RecZ
                        end case
                        case rule 
                            d5: nv t3
                            --------- nv-succ
                            _: nv (succ t3)
                        is 
                            e: t4 = rec t0 { x . x' . t1[x][x'] } t3 by rule eq
                            _: rec t0 { x . x' . t1[x][x'] } (succ t3) -> t1[t3][t4] by rule E-RecS on d5, e
                        end case
                    end case analysis
                end case
                case or e2: t2 -> t2' is
                    _: rec t0 { x . x' . t1[x][x'] } t2 -> rec t0 { x . x' . t1[x][x'] } t2' by rule E-RecA on e2
                end case
            end case analysis
        end case
    end induction  
end theorem

// H

lemma nv-is-a-normal-form:
    forall p1: nv t
    forall p2: t -> t'
    exists contradiction
    proof by induction on p1:
        case rule
            ---- nv-zero
            _: nv 0
        is 
            proof by contradiction on p2
        end case
        case rule 
            d1: nv t1
            --------- nv-succ
            _: nv succ t1
        is
            proof by case analysis on p2:
                case rule
                    d2: t2 -> t2'
                    ------------------ E-Succ
                    _: succ t2 -> succ t2'
                is
                    proof by induction hypothesis on d1, d2
                end case
            end case analysis
        end case
    end induction
end lemma

lemma values-dont-step:
    forall p1: value t
    forall p2: t -> t'
    exists contradiction
    proof by case analysis on p1:
        case rule
            d: nv t
            ------- value-nv
            _: value t
        is
            proof by lemma nv-is-a-normal-form on d, p2
        end case
        case rule
            --------------------------------- value-abs
            _: value (lambda x : T1 . t11[x]) 
        is
            proof by contradiction on p2
        end case
    end case analysis
end lemma

theorem determinacy:
    forall p1: t -> t'
    forall p2: t -> t''
    exists t' = t''
    proof by induction on p1:
    // Case - E-Succ
        case rule
            d1: t1 -> t1'
            ------------------ E-Succ
            _: succ t1 -> succ t1'
        is
            proof by case analysis on p2:
                case rule
                    d2: t1 -> t1''
                    ------------------ E-Succ
                    _: succ t1 -> succ t1''
                is
                    ih: t1' = t1'' by induction hypothesis on d1, d2
                    use inversion on ih
                    proof by rule eq
                end case
            end case analysis
        end case
    // Case - E-App1
        case rule
            d1: t1 -> t1'
            ----------------- E-App1
            _: t1 t2 -> t1' t2
        is
            proof by case analysis on p2:
                case rule
                    d2: t1 -> t1''
                    ----------------- E-App1
                    _: t1 t2 -> t1'' t2
                is
                    ih: t1' = t1'' by induction hypothesis on d1, d2
                    use inversion on ih
                    proof by rule eq
                end case
                case rule
                    d2: value t1
                    d3: t2 -> t2'
                    ----------------- E-App2
                    _: t1 t2 -> t1 t2'
                is
                    d4: contradiction by lemma values-dont-step on d2, d1
                    proof by contradiction on d4
                end case
                case rule
                    d2: value t2
                    ---------------------------------------- E-AppAbs
                    _: (lambda x : T11 . t12[x]) t2 -> t12[t2]
                is
                    d3: value (lambda x : T11 . t12[x]) by rule value-abs
                    d4: contradiction by lemma values-dont-step on d3, d1
                    proof by contradiction on d4
                end case
            end case analysis
        end case
    // Case - E-App2
        case rule
            d1: value t1
            d2: t2 -> t2'
            ----------------- E-App2
            _: t1 t2 -> t1 t2'
        is
            proof by case analysis on p2:
                case rule 
                    d3: t1 -> t1''
                    ----------------- E-App1
                    _: t1 t2 -> t1'' t2
                is 
                    d4: contradiction by lemma values-dont-step on d1, d3
                    proof by contradiction on d4
                end case
                case rule 
                    d3: value t1
                    d4: t2 -> t2''
                    ----------------- E-App2
                    d5: t1 t2 -> t1 t2''
                is 
                    ih: t2' = t2'' by induction hypothesis on d2, d4
                    use inversion on ih
                    proof by rule eq
                end case
                case rule 
                    d3: value t2
                    ---------------------------------------- E-AppAbs
                    _: (lambda x : T11 . t12[x]) t2 -> t12[t2]
                is 
                    d4: contradiction by lemma values-dont-step on d3, d2
                    proof by contradiction on d4
                end case
            end case analysis
        end case
    // Case - E-AppAbs
        case rule
            d1: value t2
            ---------------------------------------- E-AppAbs
            _: (lambda x : T11 . t12[x]) t2 -> t12[t2]
        is
            proof by case analysis on p2:
                case rule
                    d2: (lambda x : T11 . t12[x]) -> t1'
                    ------------------------------------------ E-App1
                    _: (lambda x : T11 . t12[x]) t2 -> t1' t2
                is
                    d3: value (lambda x : T11 . t12[x]) by rule value-abs
                    d4: contradiction by lemma values-dont-step on d3, d2
                    proof by contradiction on d4
                end case
                case rule
                    d2: value (lambda x : T11 . t12[x])
                    d3: t2 -> t2'
                    ---------------------------------------------------------------- E-App2
                    _: (lambda x : T11 . t12[x]) t2 -> (lambda x : T11 . t12[x]) t2'
                is
                    d4: contradiction by lemma values-dont-step on d1, d3
                    proof by contradiction on d4
                end case
                case rule
                    d2: value t2
                    ---------------------------------------- E-AppAbs
                    _: (lambda x : T11 . t12[x]) t2 -> t12[t2]
                is
                    proof by rule eq
                end case
            end case analysis
        end case
    // Case - E-RecZ
        case rule
            ---------------------------------------------- E-RecZ
            _: rec t0 { x . x' . t1[x][x'] } 0 -> t0
        is
            proof by case analysis on p2:
                case rule
                    d1: 0 -> t2'
                    ---------------------------------------------------------- E-RecA   
                    _: rec t0 { x . x' . t1[x][x'] } 0 -> rec t0 { x . x' . t1[x][x'] } t2'
                is
                    d2: nv 0 by rule nv-zero
                    d3: value 0 by rule value-nv on d2
                    d4: contradiction by lemma values-dont-step on d3, d1
                    proof by contradiction on d4
                end case
                case rule
                    ---------------------------------------------- E-RecZ
                    _: rec t0 { x . x' . t1[x][x'] } 0 -> t0
                is
                    proof by rule eq
                end case
            end case analysis
        end case
    // Case - E-RecS
        case rule
            d1: nv t3
            d2: t2 = rec t0 { x . x' . t1[x][x'] } t3
            --------------------------------------------------------- E-RecS
            _: rec t0 { x . x' . t1[x][x'] } (succ t3) -> t1[t3][t2]
        is
            proof by case analysis on p2:
                case rule 
                    d3: succ t3 -> t2'
                    ---------------------------------------------------------- E-RecA
                    _: rec t0 { x . x' . t1[x][x'] } (succ t3) -> rec t0 { x . x' . t1[x][x'] } t2'
                is
                    d4: nv succ t3 by rule nv-succ on d1
                    d5: value succ t3 by rule value-nv on d4
                    d6: contradiction by lemma values-dont-step on d5, d3
                    proof by contradiction on d6
                end case
                case rule
                    d3: nv t5
                    d4: t4 = rec t0 { x . x' . t1[x][x'] } t5
                    --------------------------------------------------------- E-RecS
                    _: rec t0 { x . x' . t1[x][x'] } (succ t5) -> t1[t5][t4]
                is
                    proof by case analysis on d2:
                        case rule
                            ------ eq
                            _: rec t0 { x . x' . t1[x][x'] } t5 = rec t0 { x . x' . t1[x][x'] } t5 // d2
                        is
                            proof by case analysis on d4: 
                                case rule
                                    ------ eq
                                    _: rec t0 { x . x' . t1[x][x'] } t5 = rec t0 { x . x' . t1[x][x'] } t5 // d4
                                is
                                    proof by rule eq
                                end case
                            end case analysis
                        end case
                    end case analysis
                end case
            end case analysis
        end case
    // Case - E-RecA
        case rule
            d1: t2 -> t2'
            ---------------------------------------------------------- E-RecA
            _: rec t0 { x . x' . t1[x][x'] } t2 -> rec t0 { x . x' . t1[x][x'] } t2'
        is
            proof by case analysis on p2:
                case rule
                    d2: t2 -> t2''
                    ---------------------------------------------------------- E-RecA
                    _: rec t0 { x . x' . t1[x][x'] } t2 -> rec t0 { x . x' . t1[x][x'] } t2''
                is
                    ih: t2' = t2'' by induction hypothesis on d1, d2
                    use inversion on ih
                    proof by rule eq
                end case
                case rule 
                    ---------------------------------------------- E-RecZ
                    _: rec t0 { x . x' . t1[x][x'] } 0 -> t0
                is 
                    proof by contradiction on d1 
                end case
                case rule 
                    d2: nv t3
                    d3: t4 = rec t0 { x . x' . t1[x][x'] } t3
                    --------------------------------------------------------- E-RecS
                    _: rec t0 { x . x' . t1[x][x'] } (succ t3) -> t1[t3][t4]
                is
                    d4: nv succ t3 by rule nv-succ on d2
                    d5: value succ t3 by rule value-nv on d4
                    d6: contradiction by lemma values-dont-step on d5, d1
                    proof by contradiction on d6
                end case
            end case analysis
        end case
    end induction
end theorem

// I

theorem preservation:
    assumes Gamma
    forall p1: Gamma |- t : T
    forall p2: t -> t'
    exists Gamma |- t' : T
    proof by induction on p1:
    // Case T-Abs
    case rule
        d1: Gamma, x : T1 |- t2[x] : T2
        ------------------------------------------- T-Abs
        _: Gamma |- lambda x : T1 . t2[x] : T1 -> T2
    is
        proof by contradiction on p2
    end case
    // Case T-App
    case rule
        d1: Gamma |- t1 : T11 -> T12
        d2: Gamma |- t2 : T11
        -------------------------- T-App
        _: Gamma |- t1 t2 : T12
    is
        proof by case analysis on p2:
            case rule
                d3: t1 -> t1'
                ----------------- E-App1
                _: t1 t2 -> t1' t2
            is
                ih: Gamma |- t1' : T11 -> T12 by induction hypothesis on d1, d3
                proof by rule T-App on ih, d2
            end case
            case rule
                _: value t1
                d3: t2 -> t2'
                ----------------- E-App2
                _: t1 t2 -> t1 t2'
            is
                ih: Gamma |- t2' : T11 by induction hypothesis on d2, d3
                proof by rule T-App on d1, ih
            end case
            case rule
                _: value t2
                ---------------------------------------- E-AppAbs
                _: (lambda x : T13 . t12[x]) t2 -> t12[t2]
            is
                d4: Gamma, x : T13 |- t12[x] : T12 by inversion on d1
                proof by substitution on d4, d2
            end case
        end case analysis
    end case
    // Case T-Zero:
    case rule
        ------------------- T-Zero
        _: Gamma |- 0 : Nat
    is
        proof by contradiction on p2
    end case
    // Case T-Succ
    case rule
        d1: Gamma |- t1 : Nat
        ------------------------ T-Succ
        _: Gamma |- succ t1 : Nat
    is
        proof by case analysis on p2:
            case rule
                d2: t1 -> t1'
                ------------------ E-Succ
                _: succ t1 -> succ t1'
            is
                ih: Gamma |- t1' : Nat by induction hypothesis on d1, d2
                proof by rule T-Succ on ih
            end case
        end case analysis
    end case
    // Case T-Rec
    case rule
        d1: Gamma |- t0 : T
        d2: Gamma, x : Nat, x' : T |- t1[x][x'] : T
        d3: Gamma |- t2 : Nat
        ----------------------------------------------------- T-Rec
        _: Gamma |- rec t0 { x . x' . t1[x][x'] } t2 : T
    is
        proof by case analysis on p2:
            case rule
                ---------------------------------------------- E-RecZ
                _: rec t0 { x . x' . t1[x][x'] } 0 -> t0
            is
                proof by d1
            end case
            case rule
                d4: nv t3
                d5: t4 = rec t0 { x . x' . t1[x][x'] } t3
                --------------------------------------------------------- E-RecS
                _: rec t0 { x . x' . t1[x][x'] } (succ t3) -> t1[t3][t4]
            is
                d6: Gamma |- t3 : Nat by inversion on d3
                d7: Gamma, x' : T |- t1[t3][x'] : T by substitution on d2, d6
                d8: Gamma |- (rec t0 { x . x' . t1[x][x'] } t3) : T by rule T-Rec on d1, d2, d6
                use inversion on d5
                proof by substitution on d7, d8
            end case
            case rule
                d4: t2 -> t2'
                ---------------------------------------------------------- E-RecA
                _: rec t0 { x . x' . t1[x][x'] } t2 -> rec t0 { x . x' . t1[x][x'] } t2'
            is
                ih: Gamma |- t2' : Nat by induction hypothesis on d3, d4
                proof by rule T-Rec on d1, d2, ih
            end case
        end case analysis
    end case
    end induction
end theorem